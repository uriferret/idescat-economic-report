model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["RutaDades","fnCsv","dim_territori","dim_any","dim_indicador","dim_sector","fact_indicadors","fact_vab","ref_oficial"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table dim_territori
ref table dim_any
ref table dim_indicador
ref table dim_sector
ref table fact_indicadors
ref table fact_vab
ref table ref_oficial

ref cultureInfo en-US

